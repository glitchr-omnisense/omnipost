# PHPStan at the highest level on the whole core (until omnisense/contracts came in, the share
# links alone: Share/, its two exceptions and its tests, which stay clean). phpstan-baseline.neon
# holds what the rest of the core had when it came in; new code adds nothing to it, and
# glitchr-studio/ci's job fails on any other error.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - docker/
        - vendor/ (?)
