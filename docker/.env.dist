# Your accounts' tokens: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnipost providers` says what each provider can do
# with what is set; capabilities and validate need nothing.

# Where the providers' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIPOST_PLUGINS=../..

# Instagram (the Instagram API with Instagram Login): the long-lived token of a
# professional account added as an Instagram Tester of the Meta app; the app's
# id and secret for `authorize` / `exchange`.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# YouTube (Data API v3): a key and the channel (UC...) to read; an OAuth client
# and the refresh token `exchange youtube` prints, to upload.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private (the default), unlisted, public
YOUTUBE_PRIVACY=private
