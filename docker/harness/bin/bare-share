#!/usr/bin/env php
<?php

/*
 * Omnipost's share links in plain PHP: Composer's autoloader and nothing
 * else - no framework, no container, no template engine, no HTTP client.
 * Builds the share registry, shares a page to every network, and prints, as
 * JSON, the links and what PHP loaded for it, past what the autoloader loads
 * by itself (Tests/Share/BareTest reads it).
 *
 *   docker compose run --rm omnipost bare-share
 *   php docker/harness/bin/bare-share     (OMNIPOST_AUTOLOAD: the autoload.php to use)
 */

$autoload = getenv('OMNIPOST_AUTOLOAD') ?: '/harness/vendor/autoload.php';
require $autoload;

// What the autoloader itself loaded (an application's "files" autoloads may load classes of
// their own): the report names only what the share links' work loads besides.
$declared = static fn (): array => array_merge(get_declared_classes(), get_declared_interfaces(), get_declared_traits());
$before = $declared();

use Omnipost\Share\Labels;
use Omnipost\Share\Registry;
use Omnipost\Share\Shareable;

$share = Registry::defaults()->share(new Shareable(
    'https://example.com/articles/fuji',
    "Le Fuji (l'ascension) & nous !",
    image: 'https://example.com/images/fuji.jpg',
    hashtags: ['japon'],
));
$label = Labels::get($share->links['pinterest']->labelKey, 'fr');

$loaded = array_values(array_filter(
    array_diff($declared(), $before),
    static fn (string $class) => !(new ReflectionClass($class))->isInternal(),
));
sort($loaded);

echo json_encode([
    'share' => $share->toArray(),
    'label' => $label,
    'loaded' => $loaded,
], \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE), "\n";
